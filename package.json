{
  "name": "zigcss",
  "version": "0.3.0",
  "description": "Experimental Zig CSS compiler prototype under correctness-first recovery",
  "main": "index.js",
  "bin": {
    "zigcss": "./index.js"
  },
  "files": [
    "index.js",
    "install.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node install.js",
    "postinstall": "node install.js",
    "dev": "node dev.js",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "build:website": "cd docs && npm ci --ignore-scripts && npm run build",
    "generate:prefix-data": "node scripts/generate-prefix-data.mjs --write",
    "check:prefix-data": "node scripts/generate-prefix-data.mjs --check",
    "test:prefix-data": "node --test scripts/generate-prefix-data.test.mjs",
    "test:zig-package": "node --test scripts/verify-zig-package.test.mjs",
    "test:node-wrapper": "node --test scripts/verify-node-wrapper.test.mjs",
    "test:compat": "node tests/compatibility/validate.mjs",
    "test:transforms": "node tests/transforms/validate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vyakymenko/zigcss.git"
  },
  "keywords": [
    "experimental",
    "zig",
    "css",
    "compiler"
  ],
  "author": "Valentyn Yakymenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vyakymenko/zigcss/issues"
  },
  "homepage": "https://github.com/vyakymenko/zigcss#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "preferGlobal": true,
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "devDependencies": {
    "@mdn/browser-compat-data": "8.0.0",
    "lightningcss": "1.30.1"
  }
}
