# ── Stage 1: build the Vite docs app ─────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /repo

# Copy the full repo (zigcss npm package lives at root, docs at /repo/docs)
COPY . .

# Install docs deps — skip postinstall so the platform binary fetch is skipped
# (we download the real binary below; compile-api-plugin is dev-only middleware)
WORKDIR /repo/docs
RUN npm ci --ignore-scripts && npm run build

# ── Stage 2: download the zigcss binary for the current platform ──────────────
FROM alpine:3.21 AS zigcss-bin
RUN apk add --no-cache curl tar

# Detect arch and pull the matching pre-built release binary
RUN ARCH=$(uname -m) && \
    case "$ARCH" in \
      x86_64)  ZIG_ARCH=x86_64  ;; \
      aarch64) ZIG_ARCH=aarch64 ;; \
      *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac && \
    curl -fSL \
      "https://github.com/vyakymenko/zigcss/releases/download/v0.3.0/zigcss-v0.3.0-${ZIG_ARCH}-linux.tar.gz" \
      -o /tmp/zigcss.tar.gz && \
    tar -xzf /tmp/zigcss.tar.gz -C /tmp && \
    find /tmp -name "zigcss" -type f | head -1 | xargs -I{} cp {} /usr/local/bin/zigcss && \
    chmod +x /usr/local/bin/zigcss

# ── Stage 3: production runtime ───────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Copy the compiled static files
COPY --from=builder /repo/docs/dist ./dist

# Copy the production server (uses ESM, no extra deps needed)
COPY --from=builder /repo/docs/server.js ./server.js

# Copy the zigcss binary
COPY --from=zigcss-bin /usr/local/bin/zigcss /usr/local/bin/zigcss

EXPOSE 80
ENV PORT=80

CMD ["node", "server.js"]
