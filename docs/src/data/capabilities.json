  "capabilities": [
    {
      "id": "css-cli",
      "surface": ".css parsing and emission",
      "status": "Experimental, matrix-tested",
      "statusKind": "experimental",
      "behavior": "Strict file/stdin and file/stdout modes delegate to `zigcss.compile`; version, syntax, options, and 0/1/2 exit statuses are executable contracts.",
      "evidence": ["compatibility", "cli-safety"]
    },
    {
      "id": "compile-api",
      "surface": "Zig compile API",
      "status": "Experimental, consumer-tested",
      "statusKind": "experimental",
      "behavior": "`zigcss.compile` returns owned CSS, maps, located diagnostics, ordered imports, optional module exports, and metrics; accepted transforms and borrowed canonical targets are explicit options.",
      "evidence": ["public-api", "documentation"]
    },
    {
      "id": "zig-package",
      "surface": "Zig package metadata",
      "status": "Experimental, consumer-tested",
      "statusKind": "experimental",
      "behavior": "Package `zigcss` 0.5.0-rc.1 declares minimum Zig 0.15.2 and a minimal source allowlist; path and fresh fetched-cache consumers resolve module `zigcss`.",
      "evidence": ["zig-package", "public-api", "release-version"]
    },
    {
      "id": "build-helper",
      "surface": "Zig build helper",
      "status": "Experimental, consumer-tested",
      "statusKind": "experimental",
      "behavior": "`@import(\"zigcss\").helpers.addCssCompile` uses declared lazy inputs and generated outputs with a host compiler artifact; unavailable CLI features have no helper path.",
      "evidence": ["build-helper", "zig-package"]
    },
    {
      "id": "native-plugins",
      "surface": "Native plugins",
      "status": "Experimental, trusted/library-only",
      "statusKind": "experimental",
      "behavior": "Explicit `.experimental` options run borrowed `plugin.`-namespaced Zig callbacks through bounded deterministic pass plans; there is no stable ABI, sandbox, CLI, or HTTP path.",
      "evidence": ["plugins", "public-api"]
    },
    {
      "id": "minify",
