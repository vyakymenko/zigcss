    },
    "release-smoke": {
      "command": "npm run test:release-smoke",
      "anchors": [
        {
          "path": "scripts/smoke-release-artifact.mjs",
          "contains": ["nativeSmokeTargets", "npm postinstall smoke", "npm-installed binary differs"]
