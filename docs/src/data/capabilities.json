        {
          "path": "tests/public-api/consumer.zig",
          "contains": ["prefixing.target_query.parse"]
        }
      ]
    },
    "format-matrix": {
      "command": "npm run test:formats",
      "anchors": [
        {
          "path": "tests/formats/validate.mjs",
          "contains": ["Format matrix verified", "validateCssModules"]
        }
      ]
    },
    "preprocessor-sass": {
      "command": "npm run test:preprocessor-sass",
      "anchors": [
        {
          "path": "tests/preprocessors/sass/corpus.test.mjs",
