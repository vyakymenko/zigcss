{
  "schemaVersion": 1,
  "statusKinds": [
    "experimental",
    "verified",
    "unavailable",
    "disabled"
  ],
  "gates": {
    "compatibility": {
      "command": "npm run test:compat",
      "anchors": [
        {
          "path": "tests/compatibility/validate.mjs",
          "contains": ["Compatibility matrix verified"]
        },
        {
          "path": "tests/compatibility/matrix.json",
          "contains": ["\"errorRecovery\": false", "\"features\""]
        }
      ]
    },
    "public-api": {
      "command": "zig build test-public-api --summary all",
      "anchors": [
        {
          "path": "build.zig",
          "contains": ["test-public-api", "tests/public-api/consumer.zig"]
        },
        {
          "path": "tests/public-api/consumer.zig",
          "contains": ["zigcss.compile(", ".source_map =", ".profile = true"]
        }
      ]
    },
    "zig-package": {
      "command": "npm run test:zig-package",
      "anchors": [
        {
          "path": "scripts/verify-zig-package.test.mjs",
          "contains": ["Zig package identity version and minimum toolchain are pinned", "explicit minimal allowlist"]
        }
      ]
    },
    "build-helper": {
      "command": "zig build test --summary all",
      "anchors": [
        {
          "path": "tests/package-consumer/build.zig",
          "contains": ["helpers.addCssCompile", "addCheckFile"]
        }
      ]
    },
    "plugins": {
      "command": "zig build test --summary all",
      "anchors": [
        {
          "path": "src/plugins.zig",
          "contains": ["pub const id_namespace = \"plugin.\"", "pub const Policy"]
        },
        {
          "path": "tests/public-api/consumer.zig",
          "contains": ["plugin.external-analysis", "PluginPolicy"]
        }
      ]
    },
    "cli-safety": {
      "command": "zig build test --summary all",
      "anchors": [
        {
          "path": "src/main.zig",
          "contains": ["atomicFile", "--minify may only be specified once", "--profile"]
        },
        {
          "path": "tests/regressions/audit.zig",
          "contains": ["runWithStdin", "--lsp"]
        }
      ]
    },
    "transforms": {
      "command": "npm run test:transforms",
      "anchors": [
        {
          "path": "tests/transforms/validate.mjs",
          "contains": ["verified-optimizer", "conservative-dead-code-extraction", "conservative-critical-css-extraction", "target-prefix-rewrite"]
        }
      ]
    },
    "prefix-data": {
      "command": "npm run check:prefix-data",
      "anchors": [
        {
          "path": "scripts/generate-prefix-data.mjs",
